# Сторонние репозитории — у каждого свой .git и своя лицензия.
# Их не публикуем, а подтягиваем отдельно (см. README).
fly-brain/
flygym/
neuromechfly/

# Кэши пакетных менеджеров
conda-pkgs/
pip-cache/

# Тяжёлые данные коннектома (~763 МБ) живут в ~/fly-brain-data,
# скачиваются отдельно и в git им не место
*.parquet
*.pkl
weight_coo.pkl
weight_csr.pkl

# Производные от аннотаций FlyWire. Репозиторий flyconnectome/flywire_annotations
# опубликован БЕЗ лицензии, поэтому перераспространять их данные, даже срезами,
# мы не вправе. Скрипты качают исходник сами — см. README.
output/annotations_matched.csv
output/neurons_descending.csv
output/neurons_ascending.csv
*.tsv

# Кэш отбора популяции нисходящих: тоже производное от аннотаций,
# пересчитывается измерением примерно за минуту.
output/dn_population_cache.npz
output/dn_population_readout.csv
output/dn_population_selected.csv

# То же самое для отбора под драйв через стык с flyvis.
output/dn_population_seam.csv
output/dn_population_seam_selected.csv
output/dn_population_seam_cache.npz

# Карта поля зрения по связям: root_id и позиция для 96 331 нейрона, то есть
# по-нейронное производное от тех же аннотаций. 6.3 МБ, пересчитывается за
# четыре минуты. Сводка по типам (visual_field_map_stats.csv) — агрегат, её
# держим в репозитории.
output/visual_field_map.csv

# Захваченный stdout прогонов: шум EGL при завершении интерпретатора,
# полезное содержимое и так лежит в CSV
output/*.log

__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/

# macOS
.DS_Store

# Производное от аннотаций FlyWire
output/retina_zone_map.npz

# Промежуточные логи прогонов гибрида
output/hvp*.log

# Разложение колонок flyvis по нейронам: root_id на каждую строку, то есть
# по-нейронное производное от аннотаций FlyWire — та же причина, что выше.
# Сводка по типам (column_assignment_stats.csv) — агрегат, её держим.
output/column_assignment.csv

# Сырые массивы прогонов гибрида: по-нейронные частоты, производное от
# аннотаций FlyWire. Пересчитывается прогоном.
output/hybrid_vision_raw.npz
